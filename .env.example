# ---------------------------------------------------------------------------
# Best Buy Canada Marketplace (Mirakl) credentials — never commit real values.
# The API key is issued per shop user in the Mirakl back office
# (My Account -> API key). It is sent RAW in the Authorization header — there is
# no "Bearer" prefix and no OAuth exchange.
# ---------------------------------------------------------------------------
BESTBUY_API_KEY=YOUR_API_KEY
# Only needed when your user has access to more than one shop.
BESTBUY_SHOP_ID=
BESTBUY_BASE_URL=https://marketplace.bestbuy.ca

# ---------------------------------------------------------------------------
# Live smoke tests (opt-in; NEVER run in CI). The live suite is READ-ONLY — it
# performs no writes to your account. Set BESTBUY_LIVE_TESTS=true (plus the key
# above) and run:
#   BESTBUY_LIVE_TESTS=true npm run test:live
# ---------------------------------------------------------------------------
BESTBUY_LIVE_TESTS=false
