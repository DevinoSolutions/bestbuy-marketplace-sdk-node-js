{
  "name": "@joinmarka/bestbuy",
  "version": "0.1.0",
  "description": "Transport-independent TypeScript SDK for the Best Buy Canada Marketplace seller API (Mirakl).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "bestbuy",
    "mirakl",
    "marketplace",
    "sdk",
    "ecommerce",
    "seller",
    "offers",
    "marka"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/bestbuy-marketplace-sdk-node-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/DevinoSolutions/bestbuy-marketplace-sdk-node-js#readme",
  "bugs": {
    "url": "https://github.com/DevinoSolutions/bestbuy-marketplace-sdk-node-js/issues"
  }
}
